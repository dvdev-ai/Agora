# Токен от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# === Qwen: выбери ОДИН провайдер ===
# Рекомендую сначала SiliconFlow или официальный DashScope.

# --- Вариант A (часто лучший для бесплатного Qwen): SiliconFlow ---
# Регистрация: https://cloud.siliconflow.com
# Хороший легкий Qwen для диалога: Qwen/Qwen3.5-9B
LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
LLM_MODEL=Qwen/Qwen3.5-9B

# --- Вариант B: официальный Alibaba Qwen (DashScope / Model Studio) ---
# Регистрация: https://modelstudio.console.alibabacloud.com/
# Новым дают бесплатную квоту (~1M токенов / 90 дней), регион Singapore.
# LLM_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# LLM_MODEL=qwen-plus
# (если intl не зайдет — попробуй LLM_PROVIDER=dashscope_cn и тот же ключ с CN-консоли)

# --- Вариант C: Groq + Qwen3-32B (бесплатно, но из РФ часто нужен VPN) ---
# https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# LLM_MODEL=qwen/qwen3-32b

# --- Вариант D: OpenRouter (Qwen есть, обычно уже платно) ---
# https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LLM_MODEL=qwen/qwen3-30b-a3b

# Сколько последних реплик помнить в диалоге
HISTORY_LIMIT=30

# Модель для расшифровки голосовых (по умолчанию подхватывается сама)
# DashScope: qwen3-asr-flash
# Groq: whisper-large-v3
# SiliconFlow: FunAudioLLM/SenseVoiceSmall
# ASR_MODEL=
